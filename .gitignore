# ==========================================
# SENADA - Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL SECURITY)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.cert
*.p12
*.pfx

# Production Builds & Caches
dist/
dist-ssr/
build/
**/dist/
**/dist-ssr/
**/build/
.cache/
**/.cache/
.vite/
**/.vite/
.vite-temp/
**/.vite-temp/

# Logs & Debugging
logs/
**/logs/*
!**/logs/.gitkeep
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploaded Files & User Documents
uploads/*
**/uploads/*
!**/uploads/.gitkeep

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# IDE & Editor Files
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
